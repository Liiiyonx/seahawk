# ===== 环境变量模板 =====
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中排除，切勿提交。

# ---- 应用 ----
APP_NAME=SeaSight
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据库 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seasight
POSTGRES_USER=seasight
POSTGRES_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- MQTT (EMQX) ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=seasight
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=seasight-backend
MQTT_TOPIC_PREFIX=marine

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_EVENTS=events
MINIO_SECURE=false

# ---- 流媒体 (go2rtc) ----
STREAM_BASE_URL=http://localhost:1984

# ---- AI 推理服务 ----
AI_SERVICE_URL=http://localhost:8081
AI_MODEL_VERSION=det_v0.1.0

# ---- CORS（前端来源，逗号分隔） ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 派单引擎参数 ----
DISPATCH_MIN_BATTERY=30
DISPATCH_MAX_BIN_USAGE=0.8
DISPATCH_ACK_TIMEOUT_SECONDS=15
DISPATCH_MERGE_WINDOW_MINUTES=10
